# Server-side only. There is no bring-your-own-key flow in this fork.
MODEL_API_KEY=

# Postgres. Create the tables with `npm run db:migrate`.
# On mori this is the local database over the unix socket:
# DATABASE_URL=postgres:///gloss?host=/var/run/postgresql
DATABASE_URL=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=https://mori.tail26dff.ts.net:8443

# Public MCP endpoint shown in agent setup instructions. On mori this is the
# Funnel URL; the reader itself remains on NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_MCP_URL=https://mori.tail26dff.ts.net:10000/mcp

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=

# LlamaParse, behind "Read it more carefully" on hard PDFs. Optional.
LLAMA_CLOUD_API_KEY=
